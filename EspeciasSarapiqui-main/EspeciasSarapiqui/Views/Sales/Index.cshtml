@model IReadOnlyList<EspeciasSarapiqui.Models.SaleListItemViewModel>
@{
    ViewBag.Title = "Ventas";
    ViewBag.subTitle = "Gestión comercial";
    Layout = null;
}

@Html.Partial("~/Views/Shared/html.cshtml")
<head>
    @Html.Partial("~/Views/Shared/title-meta.cshtml")
    @Html.Partial("~/Views/Shared/head-css.cshtml")
</head>
<body>
    <div class="wrapper">
        @Html.Partial("~/Views/Shared/menu.cshtml")
        <div class="content-page">
            <div class="content">
                <div class="container-fluid">
                    @Html.Partial("~/Views/Shared/page-title.cshtml")
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="header-title mb-0">Ventas recientes</h4>
                                <span class="text-muted">Últimas @Model.Count operación(es)</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-centered table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Factura</th>
                                            <th>Fecha</th>
                                            <th>Cliente</th>
                                            <th>Pago</th>
                                            <th class="text-end">Líneas</th>
                                            <th>Estado</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (Model.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-center text-muted py-4">No hay ventas registradas.</td></tr>
                                    }
                                    else
                                    {
                                        foreach (var sale in Model)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@sale.InvoiceNumber</td>
                                                <td>@sale.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@sale.CustomerName</td>
                                                <td>@sale.PaymentMethod</td>
                                                <td class="text-end">@sale.ItemCount</td>
                                                <td><span class="badge bg-success-subtle text-success">@sale.Status</span></td>
                                                <td class="text-end fw-semibold">@sale.Total.ToString("C2")</td>
                                            </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @Html.Partial("~/Views/Shared/footer.cshtml")
        </div>
    </div>
    @Html.Partial("~/Views/Shared/footer-scripts.cshtml")
</body>
</html>
