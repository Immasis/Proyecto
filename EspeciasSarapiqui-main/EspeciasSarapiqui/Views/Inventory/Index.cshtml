@model IReadOnlyList<EspeciasSarapiqui.Models.InventoryItemViewModel>
@{
    ViewBag.Title = "Inventario";
    ViewBag.subTitle = "Gestión comercial";
    Layout = null;
}

@Html.Partial("~/Views/Shared/html.cshtml")
<head>
    @Html.Partial("~/Views/Shared/title-meta.cshtml")
    @Html.Partial("~/Views/Shared/head-css.cshtml")
</head>
<body>
    <div class="wrapper">
        @Html.Partial("~/Views/Shared/menu.cshtml")
        <div class="content-page">
            <div class="content">
                <div class="container-fluid">
                    @Html.Partial("~/Views/Shared/page-title.cshtml")
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="header-title mb-0">Inventario</h4>
                                <span class="text-muted">@Model.Count producto(s) activo(s)</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-centered table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>SKU</th>
                                            <th>Producto</th>
                                            <th>Categoría</th>
                                            <th>Unidad</th>
                                            <th class="text-end">Existencias</th>
                                            <th class="text-end">Mínimo</th>
                                            <th class="text-end">Precio venta</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (Model.Count == 0)
                                    {
                                        <tr><td colspan="8" class="text-center text-muted py-4">No hay productos activos.</td></tr>
                                    }
                                    else
                                    {
                                        foreach (var item in Model)
                                        {
                                            var lowStock = item.Stock <= item.MinimumStock;
                                            <tr>
                                                <td><span class="fw-semibold">@item.Sku</span></td>
                                                <td>@item.Name</td>
                                                <td>@item.Category</td>
                                                <td>@item.Unit</td>
                                                <td class="text-end">@item.Stock.ToString("N3")</td>
                                                <td class="text-end">@item.MinimumStock.ToString("N3")</td>
                                                <td class="text-end">@item.SalePrice.ToString("C2")</td>
                                                <td>
                                                    @if (lowStock)
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning">Stock bajo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success">Disponible</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @Html.Partial("~/Views/Shared/footer.cshtml")
        </div>
    </div>
    @Html.Partial("~/Views/Shared/footer-scripts.cshtml")
</body>
</html>
