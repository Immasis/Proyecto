@{
    ViewBag.Title = "Dashboard";
    ViewBag.subTitle = "Resumen";
    Layout = null;
}

@Html.Partial("~/Views/Shared/html.cshtml")
<head>
    @Html.Partial("~/Views/Shared/title-meta.cshtml")
    @Html.Partial("~/Views/Shared/head-css.cshtml")
</head>
<body>
    <div class="wrapper">
        @Html.Partial("~/Views/Shared/menu.cshtml")
        <div class="content-page">
            <div class="content">
                <div class="container-fluid">
                    @Html.Partial("~/Views/Shared/page-title.cshtml")
                    <div class="row g-3">
                        <div class="col-md-6 col-xl-3">
                            <a href="@Url.Action("Index", "Products")" class="text-decoration-none">
                                <div class="card h-100"><div class="card-body"><i class="ri-box-3-line fs-28 text-primary"></i><h4 class="mt-3 mb-1">Productos</h4><p class="text-muted mb-0">Consultar y administrar productos.</p></div></div>
                            </a>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <a href="@Url.Action("Index", "Customers")" class="text-decoration-none">
                                <div class="card h-100"><div class="card-body"><i class="ri-user-3-line fs-28 text-success"></i><h4 class="mt-3 mb-1">Clientes</h4><p class="text-muted mb-0">Consultar clientes registrados.</p></div></div>
                            </a>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <a href="@Url.Action("Index", "Inventory")" class="text-decoration-none">
                                <div class="card h-100"><div class="card-body"><i class="ri-archive-line fs-28 text-warning"></i><h4 class="mt-3 mb-1">Inventario</h4><p class="text-muted mb-0">Revisar existencias y movimientos.</p></div></div>
                            </a>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <a href="@Url.Action("Index", "Sales")" class="text-decoration-none">
                                <div class="card h-100"><div class="card-body"><i class="ri-shopping-cart-line fs-28 text-danger"></i><h4 class="mt-3 mb-1">Ventas</h4><p class="text-muted mb-0">Registrar y consultar ventas.</p></div></div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            @Html.Partial("~/Views/Shared/footer.cshtml")
        </div>
    </div>
    @Html.Partial("~/Views/Shared/footer-scripts.cshtml")
</body>
</html>